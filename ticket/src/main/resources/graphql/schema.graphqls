scalar BigDecimal

type Query {
    # Get an user tickt by id
    ticket(id: ID!): TicketResponse!
    # Get a list of tickets available for purchase with cursor-based pagination
    ticketsForPurchase(first: Int, after: String, last: Int, before: String): TicketResponseConnection
    # Get a list of user created tickets with cursor-based pagination
    tickets(first: Int, after: String, last: Int, before: String): TicketResponseConnection
}

type Mutation {
    # For user to create an event ticket
    create(createTicketRequest: CreateTicketRequest!): TicketResponse!
    # For user to update an event ticket
    update(updateTicketRequest: UpdateTicketRequest!): TicketResponse!
}

# Input values to create a ticket
input CreateTicketRequest {
    title: String!
    price: BigDecimal!
}

input UpdateTicketRequest {
    id: ID!
    title: String!
    price: BigDecimal!
}

type TicketResponse {
    id: ID!
    title: String!
    price: String!
    userId: ID!
    orderId: ID
}
