scalar DateTime

type Query {
    # Get an user payment by id and token
    payment(orderId: ID!, userId: ID!, token: String!): PaymentResponse!
}

type Mutation {
    # For user to make a payment using Stripe payment processor
    stripePayment(stripePaymentRequest: StripePaymentRequest!): PaymentResponse!
}

# Input values to make a payment
input StripePaymentRequest {
    orderId: ID!
    token: String!
}

type PaymentResponse {
    status: String!
    message: String
}
