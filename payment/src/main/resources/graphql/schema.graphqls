scalar DateTime

type Query {
    # Get an user payment by id and token
    payment(userId: ID!, token: String!): PaymentResponse!
}

type Mutation {
    # For user to make a payment
    payment(paymentRequest: PaymentRequest!): PaymentResponse!
}

# Input values to make a payment
input PaymentRequest {
    userId: ID!
    token: String!
}

type PaymentResponse {
    status: String!
}
