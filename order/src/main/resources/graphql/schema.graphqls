scalar DateTime
scalar DateTimeUtc
scalar DateTimeLocal
scalar BigDecimal

type Query {
    # Get a list of user orders with cursor-based pagination
    orders(first: Int, after: String, last: Int, before: String): OrderResponseConnection
    # Get an user order by id
    order(id: ID!): OrderResponse!
}

type Mutation {
    # For user to create an order
    create(createOrderRequest: CreateOrderRequest!): OrderResponse!
    # For user to cancel an order
    cancel(cancelOrderRequest: CancelOrderRequest!): OrderResponse!
}

# Input values to create an order
input CreateOrderRequest {
    ticketId: ID!
}

# Input values to cancel an order
input CancelOrderRequest {
    orderId: ID!
}

type OrderResponse {
    id: ID!
    ticketId: ID!,
    ticketTitle: String!
    quantity: Int
    totalAmount: BigDecimal!
    # Ref to the original ticket not the snapshot
    ticket: TicketResponse!
    sellerId: ID!
    buyerId: ID!
    buyerFirstName: String!
    buyerLastName: String!
    status: String!
    createdAtUtc: DateTimeUtc
    createdAtLocal: DateTimeLocal
}

type TicketResponse {
    id: ID!
    title: String!
    price: String!
}
